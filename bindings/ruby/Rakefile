# frozen_string_literal: true

require "rake/testtask"
require "bundler/gem_tasks"
require "rb_sys/extensiontask"

GEMSPEC = Gem::Specification.load("ironpages.gemspec")

RbSys::ExtensionTask.new("ironpages-ruby", GEMSPEC) do |extension|
  extension.ext_dir = "ext/ironpages"
  extension.lib_dir = "lib/ironpages"
  extension.source_pattern = "*.{rb,rs,toml,lock}"
  extension.cross_compile = true
  extension.cross_platform = [
    "x86_64-linux",
    "aarch64-linux",
    "x86_64-darwin",
    "arm64-darwin",
    "x64-mingw-ucrt"
  ]
end

Rake::TestTask.new do |task|
  task.libs << "lib"
  task.pattern = "test/**/*_test.rb"
end

task default: %i[compile test]
